# 완전 로컬 실행: copy .env.example .env.local 후 SESSION_SECRET 만 반드시 바꿔 주세요.

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 로컬 MongoDB (Community 또는 docker compose up -d). DB명은 MONGODB_DB가 URI 경로보다 우선(미설정 시 axplayground)
MONGODB_URI=mongodb://127.0.0.1:27017/axplayground
# MONGODB_DB=axplayground
SESSION_SECRET=여기에_32자_이상_랜덤_문자열

# Ollama 예: ollama pull gemma4:E2B (모델 이름은 ollama list 와 동일하게)
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_MODEL=gemma4:E2B
OPENAI_COMPATIBLE_API_KEY=ollama

# LLM 운영 노브(다수 사용자 대비) — 미설정 시 기본값. 내부 모델 서버 용량에 맞춰 조정.
# LLM_MAX_CONCURRENCY=8      # 동시 LLM 호출 상한(전역 세마포어)
# LLM_MAX_QUEUE=24           # 대기열 상한 — 초과 시 503(백프레셔)
# LLM_TIMEOUT_MS=180000      # LLM 요청 타임아웃(ms, 기본 3분)
# LLM_MAX_RETRIES=1          # LLM 클라이언트 재시도 횟수
# SUBPROC_MAX_CONCURRENCY=4  # HWPX·OCR·kordoc 등 동시 자식 프로세스 상한
# SUBPROC_MAX_QUEUE=12       # 자식 프로세스 대기열 상한

# 사규 임베딩 — 현재 미사용(사규 검색은 MongoDB $text + 키워드). 향후 벡터검색 대비 예약 변수
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# nomic-embed-text 는 768차원. 다른 모델이면 출력 차원에 맞게:
# EMBEDDING_DIMENSIONS=768

# 국가법령정보센터 Open API (외부 법령 검색 — 인터넷 필요)
# 법제처 오픈API 마이페이지의 OC 입력
LAW_API_OC=

# /setup 시드 / CORS / 배포용 (선택)
# CORS_ORIGIN=http://localhost:3000

# 관리자 진입 암호키 (8자 이상)
ADMIN_ACCESS_KEY=
# 업로드 저장 경로 (미설정 시 public/uploads).
# 폐쇄망 운영: 배포 디렉토리 '밖' 영구 경로 권장 — 코드 재배포·git clean 시 업로드 유실 방지.
# 예) UPLOAD_DIR=/var/lib/axplayground/uploads
UPLOAD_DIR=

# ── 폐쇄망 외부연결 원천 차단(방어적 안전망) ──
# 앱·kordoc은 외부 API를 쓰지 않는다. 단 kordoc의 '선택' 기능(PDF 수식 OCR, --formula-ocr)은
# 켤 경우에만 huggingface에서 ONNX 모델을 받는데, 우리는 이 옵션을 어디서도 넘기지 않아 트리거되지 않는다.
# 그래도 폐쇄망 원칙상 어떤 경로로도 외부 접속이 없도록 아래를 켜 두면 물리적으로 봉쇄된다(무해).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── Windows 폐쇄망: 문서작성(HWPX) + 광고심의 OCR 공통 Python ──
# setup-ocr-windows.ps1 실행 후 경로 지정. 미설정 시 tools/ocr/.venv (dev용)
# OCR_PROVIDER=python
# PYTHON_BIN=C:\axp\ocr\venv\Scripts\python.exe

# LLM 호출 상한(ms). Ollama 응답 없을 때 dev 서버 hung 방지. 기본 120000
# LLM_TIMEOUT_MS=120000
